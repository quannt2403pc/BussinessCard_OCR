# Sao chep thanh .env roi dien gia tri. KHONG commit .env.
# Chu so huu: Q | Task: 1.4 / 9.1

# --- Database ---
POSTGRES_USER=bizcard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bizcard
DATABASE_URL=postgresql+psycopg://bizcard:change-me@db:5432/bizcard

# --- CLIProxyAPI (OAuth toi Gemini) ---
# Image cong khai tren Docker Hub - KHONG can co ma nguon CLIProxyAPI o may.
# Ghim theo tag/digest thay vi :latest sau khi chot o task 2.1.
CLIPROXY_IMAGE=eceasy/cli-proxy-api:latest
# Management key: phai dat TRUNG voi remote-management.secret-key trong cliproxy/config.yaml.
# Tao file do bang: cp cliproxy/config.example.yaml cliproxy/config.yaml
CLIPROXY_BASE_URL=http://cliproxy:8317
CLIPROXY_MGMT_KEY=change-me
# Provider OAuth: dung 'antigravity' (OAuth Google) - CLIProxy KHONG co gemini-auth-url built-in
CLIPROXY_AUTH_PROVIDER=antigravity
# Phai la model CO THAT trong channel antigravity (I-03). 'gemini-flash-latest' thuoc channel
# aistudio/gemini, can API key - goi qua antigravity se khong chay.
# Xem danh muc hien tai:
#   curl -H "Authorization: Bearer $CLIPROXY_MGMT_KEY" \
#        localhost:8317/v0/management/model-definitions/antigravity
LLM_MODEL=gemini-3-flash

# Viet hoa sau khi quet (EX-02): dich chuc vu / loai hinh phap nhan va phien am ten rieng bang
# MOT LOI GOI MODEL THU HAI tren moi anh. Tat di thi chi con bang tra cuu tat dinh -- van dich
# duoc chuc vu va loai hinh quen thuoc, chi khong phien am duoc ten rieng. Tat khi may sat han
# muc (R5): tha mat ban dich con hon mat luot quet.
TRANSLATE_AFTER_OCR=true

# --- Embedding (KHONG di qua CLIProxy - xem Plan.md muc 2.6) ---
EMBEDDER_URL=http://embedder:8001
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- App ---
# Khoa ky cookie phien dang nhap (task 12.2). Doi thanh chuoi ngau nhien dai tren moi may that:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me
SESSION_MAX_AGE_DAYS=7
SESSION_COOKIE_SECURE=false
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10

# --- Van hanh (task 9.1 / 9.2 / 9.5) ---
# Muc log goc: DEBUG | INFO | WARNING | ERROR.
# DEBUG in them dong access cua /health va /static/* - huu ich khi soi healthcheck, on khi chay lau.
LOG_LEVEL=INFO
# true = SQLAlchemy in moi cau SQL. Chi bat khi dang go loi truy van.
DEBUG=false

# Swagger /docs, /redoc va /openapi.json (I-43). Mac dinh false - tat ca ba deu khong ton tai.
# Bat len khi can tra tai lieu API luc dang lam; TUYET DOI de false tren may chu that:
# /openapi.json mo ta toan bo be mat API, do la ban do do tim don san cho nguoi muon thu pha.
DOCS_ENABLED=false
# Entrypoint cua container api chay `alembic upgrade head` truoc khi khoi dong uvicorn.
# Dat 0 khi co y muon len voi schema hien tai (vi du dang go loi mot migration hong).
RUN_MIGRATIONS=1

# LUU Y: KHONG bat buoc phai co file .env. Moi bien o tren deu co mac dinh trong
# docker-compose.yml (`${VAR:-...}`), nen may sach chi can `docker compose up -d`.
# Chep file nay thanh .env khi muon doi gia tri (nho doi ca secret-key trong cliproxy/config.yaml
# cho trung CLIPROXY_MGMT_KEY).
