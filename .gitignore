# Bí mật & cấu hình môi trường
# ============================================================
.env
.env.*
!.env.example
# Bản mẫu cho máy chủ (task 13.6). Chỉ là khuôn có chú thích, mọi giá trị đều là chỗ trống
# ghi "SINH-NGAU-NHIEN" — file `.env` thật trên máy chủ vẫn bị `.env.*` ở trên chặn.
!.env.prod.example
*.pem
*.key
secrets/
cliproxy/config.yaml
cliproxy/auths/
# Tu task 9.1, container cliproxy mount ca thu muc `cliproxy/` (de `cliproxy-init` tao duoc
# config.yaml, xem ghi chu trong docker-compose.yml) nen CLIProxy ghi them bang dieu khien
# ~2.8MB vao day moi lan khoi dong. Khong phai file cua ta.
cliproxy/static/

