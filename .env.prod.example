# Bien moi truong cho ban chay that tren Compute Engine.
# Chu so huu: Q | Task: 13.6 | xem docs/deploy.md
#
# Tren may chu: chep thanh /opt/bizcard/.env roi `chmod 600`.
# KHONG commit file .env that - gitleaks dang canh, va .gitignore da co `.env`.
#
#     cp .env.prod.example .env && chmod 600 .env
#
# Khac han .env.example (ban localhost) o mot diem: o day KHONG co gia tri mac dinh nao
# chay duoc. docker-compose.prod.yml dung cu phap ${VAR:?...} cho moi bi mat, nen thieu
# mot dong la `docker compose up` chet ngay kem ten bien - co y nhu vay, de khong bao gio
# co chuyen deploy that voi mat khau `change-me`.

# --- Ten mien & chung chi (task 13.5, 13.6) ---
SITE_DOMAIN=ocrximi.io.vn
# Dia chi Let's Encrypt gui thu khi chung chi sap het han hoac ACME co su co.
ACME_EMAIL=doi-thanh-email-that@example.com

# --- Bi mat: SINH NGAU NHIEN TREN MAY CHU, dung chep tu day ---
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Sinh ca ba, moi cai mot lan:
POSTGRES_USER=bizcard
POSTGRES_PASSWORD=SINH-NGAU-NHIEN
POSTGRES_DB=bizcard
# Phai khop voi ba bien ngay tren.
DATABASE_URL=postgresql+psycopg://bizcard:SINH-NGAU-NHIEN@db:5432/bizcard

# Khoa ky cookie phien dang nhap. Doi khoa nay = dang xuat toan bo nguoi dung.
SECRET_KEY=SINH-NGAU-NHIEN

# Management key cua CLIProxy.
# ⚠️ PHAI TRUNG voi `remote-management.secret-key` trong cliproxy/config.yaml TREN MAY CHU.
# cliproxy-init chi chep config.example.yaml (secret-key: "change-me") o lan chay dau, no
# KHONG biet gi ve .env - phai tu sua file do mot lan luc dung may. Xem docs/deploy.md.
CLIPROXY_MGMT_KEY=SINH-NGAU-NHIEN

# --- Anh image: ghim de deploy lai ra dung thu da chay (task 13.8) ---
# `:latest` nghia la upstream day ban moi la hanh vi he thong doi ma khong ai sua dong nao.
CLIPROXY_IMAGE=eceasy/cli-proxy-api:latest
CADDY_IMAGE=caddy:2.10-alpine

# --- Mo hinh & embedding: giu giong ban localhost ---
CLIPROXY_BASE_URL=http://cliproxy:8317
CLIPROXY_AUTH_PROVIDER=antigravity
LLM_MODEL=gemini-3-flash
TRANSLATE_AFTER_OCR=true
EMBEDDER_URL=http://embedder:8001
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Ung dung ---
SESSION_MAX_AGE_DAYS=7
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO
RUN_MIGRATIONS=1

# KHONG khai o day, docker-compose.prod.yml ep cung va se ghi de:
#   SESSION_COOKIE_SECURE=true   (cookie phien chi di qua HTTPS)
#   DEBUG=false                  (trang loi khong phoi traceback)
# Hai thu nay quen mot dong la hong am tham, nen khong de cho .env quyet dinh.
